/-- The first `n` certificates packed in `N`. -/
def unpackCerts (N : Nat) : Nat → List Nat
  | 0 => []
  | n + 1 => N % 2 ^ 128 :: unpackCerts (N / 2 ^ 128) n

/-- One pool of `k` primes, 16 bits each. -/
def unpackPool (N : Nat) : Nat → List Nat
  | 0 => []
  | k + 1 => N % 2 ^ 16 :: unpackPool (N / 2 ^ 16) k

/-- The first `n` pools packed in `N`. -/
def unpackPools (N : Nat) : Nat → List (List Nat)
  | 0 => []
  | n + 1 => unpackPool N 20 :: unpackPools (N / 2 ^ 320) n

def killCerts : List Nat := killChunks.flatMap fun c => unpackCerts c.2 c.1

def survivorPools : List (List Nat) := survivorChunks.flatMap fun c => unpackPools c.2 c.1

end Erdos307
